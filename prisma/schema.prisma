generator client {
  provider        = "prisma-client"
  output          = "../lib/db/generated"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "identity", "object_storage"]
